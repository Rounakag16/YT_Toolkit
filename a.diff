+// A single hook that gives every action panel the same behavior:
+// - one in-flight request at a time
+// - result/error clear automatically the instant any input changes,
+//   so switching e.g. MP4 -> MP3 never leaves a stale MP4 link on screen
+function useAction(deps) {
+  const [status, setStatus] = useState("idle"); // idle | loading | done | error
+  const [result, setResult] = useState(null);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    setResult(null); setError(""); setStatus("idle");
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, deps);
+
+  const run = useCallback(async (fn) => {
+    if (status === "loading") return;
+    setStatus("loading"); setError("");
+    try {
+      const data = await fn();
+      if (data && data.error) { setStatus("error"); setError(data.error); return null; }
+      setResult(data);
+      setStatus("done");
+      return data;
+    } catch (e) {
+      setStatus("error"); setError(String(e));
+      return null;
+    }
+  }, [status]);
+
+  return { status, result, error, run, disabled: status === "loading" || status === "done" };
 }
 
