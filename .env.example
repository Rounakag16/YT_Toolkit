# Copy this file to .env and fill in what you need.

# Where downloaded files are saved.
# Defaults to your OS Downloads folder (~/Downloads/ytoolkit) — same
# place Chrome/browsers save files, just in its own subfolder. Set this
# to override, e.g. an absolute path to your Desktop instead.
YTOOLKIT_DOWNLOAD_DIR=

# --- AI summarization (optional) ---
# "gemini" (free-tier API, needs key) or "ollama" (fully local, needs
# Ollama running) or "none" to disable.
YTOOLKIT_AI_PROVIDER=none

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Requires `ollama serve` running and `ollama pull gpt-oss:20b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# --- yt-dlp cookies (only needed for age-restricted / private videos) ---
# One of these, not both. Browser name e.g. chrome / firefox / edge:
YTOOLKIT_COOKIES_FROM_BROWSER=
# Or a path to a Netscape-format cookies.txt file:
YTOOLKIT_COOKIES_FILE=
